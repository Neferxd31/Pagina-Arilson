---
import type { Product } from '../lib/db';
import { formatPrice, imageUrl } from '../lib/format';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const totalStock = product.variants.reduce((sum, variant) => sum + variant.stock, 0);
const colors = product.variants.filter((variant) => variant.colorHex);
---

<a href={`/p/${product.slug}`} class="card">
  <div class="card-image">
    <img
      src={imageUrl(product.images[0] ?? '')}
      alt={product.title}
      loading="lazy"
      width="400"
      height="400"
      class:list={{ placeholder: product.images.length === 0 }}
    />
    {totalStock === 0 && <span class="badge badge-out">Agotado</span>}
    {totalStock > 0 && product.compareAtPrice && <span class="badge">Oferta</span>}
    {totalStock > 0 && !product.compareAtPrice && product.isNew && <span class="badge badge-new">Nuevo</span>}
  </div>
  <div class="card-body">
    <h3>{product.title}</h3>
    {
      colors.length > 1 && (
        <div class="dots" aria-label={`${colors.length} colores`}>
          {colors.slice(0, 6).map((variant) => (
            <span style={`background:${variant.colorHex}`} title={variant.colorName} />
          ))}
        </div>
      )
    }
    <p class="card-price">
      <span class="price">{formatPrice(product.price)}</span>
      {product.compareAtPrice && <span class="price-old">{formatPrice(product.compareAtPrice)}</span>}
    </p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow);
  }

  .card:hover {
    transform: translateY(-3px);
  }

  .card-image {
    position: relative;
    aspect-ratio: 1;
    background: var(--mint);
  }

  .card-image {
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }

    .card:hover {
      box-shadow: 0 14px 32px rgba(37, 40, 74, 0.14);
    }

    .card-image img {
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card:hover .card-image img {
      transform: scale(1.06);
    }
  }

  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--teal);
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .badge-new {
    background: var(--mint-strong);
  }

  .badge-out {
    background: var(--navy);
    color: #fff;
  }

  .card-body {
    padding: 12px 14px 14px;
    display: grid;
    gap: 6px;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dots {
    display: flex;
    gap: 4px;
  }

  .dots span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  .card-price {
    margin: 0;
  }
</style>
