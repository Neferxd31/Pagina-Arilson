---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu carrito">
  <div class="container cart-page">
    <h1>Tu carrito</h1>

    <div id="cart-empty" class="empty" hidden>
      <p>Tu carrito está vacío.</p>
      <a href="/productos" class="btn">Ver productos</a>
    </div>

    <div id="cart-content" class="layout" hidden>
      <ul id="cart-lines" class="lines"></ul>

      <form id="checkout" class="checkout" method="post" novalidate>
        <div class="total-row">
          <span>Total productos</span>
          <strong id="cart-total" class="price"></strong>
        </div>
        <p class="hint">El envío (Cúcuta o nacional) y el pago se coordinan por WhatsApp.</p>

        <label class="field">
          Nombre completo
          <input name="name" autocomplete="name" required maxlength="80" />
        </label>
        <label class="field">
          Ciudad
          <input name="city" autocomplete="address-level2" required maxlength="60" value="Cúcuta" />
        </label>
        <label class="field">
          Dirección y barrio
          <input name="address" autocomplete="street-address" required maxlength="160" />
        </label>
        <label class="field">
          Notas <span class="hint">(opcional)</span>
          <textarea name="notes" maxlength="300" rows="2"></textarea>
        </label>

        <label class="consent">
          <input type="checkbox" name="acceptsPrivacy" required />
          <span>
            Autorizo el tratamiento de mis datos personales para gestionar mi pedido, según la{' '}
            <a href="/privacidad" target="_blank">Política de privacidad</a>.
          </span>
        </label>

        <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-language="es" data-theme="light" data-size="flexible"></div>

        <div id="checkout-errors" class="alert" hidden></div>

        <button type="submit" class="btn btn-whatsapp" id="checkout-button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5c0-5.19 4.23-9.42 9.43-9.42a9.37 9.37 0 0 1 9.42 9.43c0 5.2-4.23 9.43-9.42 9.43m8.02-17.45A11.27 11.27 0 0 0 12.05.73C5.8.73.7 5.82.7 12.08c0 2 .52 3.95 1.52 5.67L.6 23.65l6.04-1.58a11.33 11.33 0 0 0 5.41 1.38h.01c6.25 0 11.35-5.1 11.35-11.35 0-3.03-1.18-5.88-3.33-8.03"></path>
          </svg>
          Pedir por WhatsApp
        </button>
      </form>
    </div>
  </div>
</Layout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { cartTotal, removeFromCart, setCartQty, type CartItem } from '../lib/cart';
  import { formatPrice, imageUrl } from '../lib/format';
  import { loadCart, saveCart } from '../scripts/cart-store';

  const linesList = document.getElementById('cart-lines')!;
  const emptyState = document.getElementById('cart-empty')!;
  const content = document.getElementById('cart-content')!;
  const totalLabel = document.getElementById('cart-total')!;
  const form = document.getElementById('checkout') as HTMLFormElement;
  const errorBox = document.getElementById('checkout-errors')!;
  const submitButton = document.getElementById('checkout-button') as HTMLButtonElement;

  let cart: CartItem[] = loadCart();

  function lineTemplate(line: CartItem): string {
    const title = escapeHtml(line.title);
    return `
      <li class="line" data-variant-id="${line.variantId}">
        <a href="/p/${encodeURIComponent(line.slug)}"><img src="${imageUrl(line.image)}" alt="" width="72" height="72" /></a>
        <div class="line-info">
          <a href="/p/${encodeURIComponent(line.slug)}" class="line-title">${title}</a>
          <span class="hint">${escapeHtml(line.color)} · ${formatPrice(line.price)}</span>
          <div class="line-controls">
            <div class="qty">
              <button type="button" data-action="minus" aria-label="Quitar uno">−</button>
              <output>${line.qty}</output>
              <button type="button" data-action="plus" aria-label="Agregar uno" ${line.qty >= line.maxStock ? 'disabled' : ''}>+</button>
            </div>
            <button type="button" class="remove" data-action="remove">Eliminar</button>
          </div>
        </div>
        <strong class="line-subtotal">${formatPrice(line.price * line.qty)}</strong>
      </li>`;
  }

  function escapeHtml(text: string): string {
    const element = document.createElement('span');
    element.textContent = text;
    return element.innerHTML;
  }

  function render() {
    emptyState.hidden = cart.length > 0;
    content.hidden = cart.length === 0;
    linesList.innerHTML = cart.map(lineTemplate).join('');
    totalLabel.textContent = formatPrice(cartTotal(cart));
  }

  function update(nextCart: CartItem[]) {
    cart = nextCart;
    saveCart(cart);
    render();
  }

  linesList.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
    if (!button) return;

    const variantId = Number(button.closest<HTMLElement>('.line')!.dataset.variantId);
    const line = cart.find((item) => item.variantId === variantId);
    if (!line) return;

    if (button.dataset.action === 'minus') update(setCartQty(cart, variantId, line.qty - 1));
    if (button.dataset.action === 'plus') update(setCartQty(cart, variantId, line.qty + 1));
    if (button.dataset.action === 'remove') update(removeFromCart(cart, variantId));
  });

  function showErrors(errors: string[]) {
    errorBox.innerHTML = `<ul>${errors.map((error) => `<li>${escapeHtml(error)}</li>`).join('')}</ul>`;
    errorBox.hidden = false;
  }

  // Each Turnstile token works only once, so a rejected order needs a fresh check
  function resetTurnstile() {
    (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const formData = new FormData(form);
    const turnstileToken = String(formData.get('cf-turnstile-response') ?? '');
    const acceptsPrivacy = formData.get('acceptsPrivacy') === 'on';
    formData.delete('cf-turnstile-response');
    formData.delete('acceptsPrivacy');
    if (!turnstileToken) {
      showErrors(['Espera un momento a que termine la verificación de seguridad.']);
      return;
    }

    errorBox.hidden = true;
    submitButton.disabled = true;

    try {
      const response = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer: Object.fromEntries(formData),
          items: cart.map((line) => ({ variantId: line.variantId, qty: line.qty })),
          turnstileToken,
          acceptsPrivacy,
        }),
      });
      const result = (await response.json()) as { whatsappUrl?: string; errors?: string[] };

      if (!response.ok || !result.whatsappUrl) {
        showErrors(result.errors ?? ['No pudimos registrar el pedido. Intenta de nuevo.']);
        resetTurnstile();
        submitButton.disabled = false;
        return;
      }

      saveCart([]);
      // Same-tab navigation: mobile browsers block window.open after an await
      location.href = result.whatsappUrl;
    } catch {
      showErrors(['Revisa tu conexión a internet e intenta de nuevo.']);
      resetTurnstile();
      submitButton.disabled = false;
    }
  });

  render();
</script>

<style>
  .cart-page {
    padding-top: 24px;
  }

  h1 {
    font-size: 1.6rem;
  }

  .empty {
    padding: 48px 0;
    text-align: center;
  }

  .layout {
    display: grid;
    gap: 24px;
  }

  .layout[hidden],
  .empty[hidden] {
    display: none;
  }

  @media (min-width: 860px) {
    .layout {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }

  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .lines :global(.line) {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    padding: 12px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .lines :global(.line img) {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 10px;
    background: var(--mint);
  }

  .lines :global(.line-info) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .lines :global(.line-title) {
    font-weight: 600;
    text-decoration: none;
  }

  .lines :global(.line-controls) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 6px;
  }

  .lines :global(.qty button) {
    width: 34px;
    height: 34px;
  }

  .lines :global(.qty button:disabled) {
    opacity: 0.3;
  }

  .lines :global(.remove) {
    border: 0;
    background: none;
    color: var(--danger);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 4px;
  }

  .lines :global(.line-subtotal) {
    grid-column: 2;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  @media (min-width: 520px) {
    .lines :global(.line) {
      grid-template-columns: 72px minmax(0, 1fr) auto;
    }

    .lines :global(.line-subtotal) {
      grid-column: auto;
    }
  }

  .checkout {
    display: grid;
    gap: 14px;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  @media (min-width: 860px) {
    .checkout {
      position: sticky;
      top: 80px;
    }
  }

  .total-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.15rem;
  }

  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--muted);
    cursor: pointer;
  }

  .consent input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--navy);
  }

  .checkout .hint {
    margin: -6px 0 0;
  }
</style>
