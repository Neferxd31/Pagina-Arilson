---
import { env } from 'cloudflare:workers';
import ProductCard from '../components/ProductCard.astro';
import Layout from '../layouts/Layout.astro';
import { catalogUrl, PAGE_SIZE, parseCatalogFilters, SORT_OPTIONS } from '../lib/catalog';
import { listCategories, searchProducts } from '../lib/db';
import { formatPrice } from '../lib/format';

const categories = await listCategories(env.DB);
const filters = parseCatalogFilters(
  Astro.url.searchParams,
  categories.map((category) => category.slug),
);
const { products, total } = await searchProducts(env.DB, filters);

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const currentCategory = categories.find((category) => category.slug === filters.category);

// Chips para ver y quitar cada filtro activo con un toque
const activeFilters = [
  filters.search && { label: `"${filters.search}"`, href: catalogUrl(filters, { search: '' }) },
  currentCategory && { label: currentCategory.name, href: catalogUrl(filters, { category: '' }) },
  filters.minPrice !== null && { label: `Desde ${formatPrice(filters.minPrice)}`, href: catalogUrl(filters, { minPrice: null }) },
  filters.maxPrice !== null && { label: `Hasta ${formatPrice(filters.maxPrice)}`, href: catalogUrl(filters, { maxPrice: null }) },
  filters.inStock && { label: 'Disponibles', href: catalogUrl(filters, { inStock: false }) },
  filters.onSale && { label: 'En oferta', href: catalogUrl(filters, { onSale: false }) },
].filter((item): item is { label: string; href: string } => Boolean(item));

const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1).filter(
  (page) => page === 1 || page === totalPages || Math.abs(page - filters.page) <= 1,
);
---

<Layout title={currentCategory ? currentCategory.name : 'Productos'}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Catálogo</p>
      <h1>{currentCategory ? currentCategory.name : 'Todos los productos'}</h1>
      <p class="section-lead">Tecnología útil, elegida con criterio. Filtra por categoría, precio o disponibilidad.</p>
    </div>
  </section>

  <form class="container catalog" method="get" action="/productos" id="catalog-form">
    <div class="search">
      <label class="visually-hidden" for="q">Buscar productos</label>
      <input id="q" name="q" type="search" placeholder="¿Qué estás buscando?" value={filters.search} />
      <button class="btn" type="submit">Buscar</button>
    </div>

    <div class="layout">
      <details class="filters" open={activeFilters.length > 0 ? true : undefined}>
        <summary>Filtros {activeFilters.length > 0 && <span class="count">{activeFilters.length}</span>}</summary>

        <fieldset>
          <legend>Categoría</legend>
          <div class="category-options">
            <label class="option">
              <input type="radio" name="categoria" value="" checked={!filters.category} />
              Todas
            </label>
            {
              categories.map((category) => (
                <label class="option">
                  <input type="radio" name="categoria" value={category.slug} checked={filters.category === category.slug} />
                  {category.name}
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>Precio (COP)</legend>
          <div class="price-range">
            <label class="field">
              <span class="hint">Desde</span>
              <input name="min" type="number" inputmode="numeric" min="0" step="1000" value={filters.minPrice ?? ''} placeholder="0" />
            </label>
            <label class="field">
              <span class="hint">Hasta</span>
              <input name="max" type="number" inputmode="numeric" min="0" step="1000" value={filters.maxPrice ?? ''} placeholder="Sin límite" />
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Mostrar</legend>
          <label class="option">
            <input type="checkbox" name="disponibles" value="1" checked={filters.inStock} />
            Solo disponibles
          </label>
          <label class="option">
            <input type="checkbox" name="oferta" value="1" checked={filters.onSale} />
            Solo en oferta
          </label>
        </fieldset>

        <div class="filter-actions">
          <button type="submit" class="btn btn-small">Aplicar filtros</button>
          <a href="/productos" class="btn btn-ghost btn-small">Limpiar</a>
        </div>
      </details>

      <div class="results">
        <div class="results-bar">
          <p class="results-count">{total} {total === 1 ? 'producto' : 'productos'}</p>
          <label class="sort">
            <span>Ordenar por</span>
            <select name="orden" id="sort-select">
              {SORT_OPTIONS.map((option) => <option value={option.id} selected={filters.sort === option.id}>{option.label}</option>)}
            </select>
          </label>
        </div>

        {
          activeFilters.length > 0 && (
            <ul class="active-filters">
              {activeFilters.map((item) => (
                <li>
                  <a href={item.href} aria-label={`Quitar filtro ${item.label}`}>
                    {item.label} <span aria-hidden="true">×</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {
          products.length > 0 ? (
            <div class="product-grid">
              {products.map((product) => (
                <ProductCard product={product} />
              ))}
            </div>
          ) : (
            <div class="empty">
              <p>No encontramos productos con estos filtros.</p>
              <a href="/productos" class="btn btn-ghost btn-small">
                Ver todos los productos
              </a>
            </div>
          )
        }

        {
          totalPages > 1 && (
            <nav class="pagination" aria-label="Páginas">
              {filters.page > 1 && <a href={catalogUrl(filters, { page: filters.page - 1 })}>← Anterior</a>}
              {pageNumbers.map((page, index) => (
                <>
                  {index > 0 && page - pageNumbers[index - 1] > 1 && <span class="gap">…</span>}
                  <a href={catalogUrl(filters, { page })} class:list={{ current: page === filters.page }} aria-current={page === filters.page ? 'page' : undefined}>
                    {page}
                  </a>
                </>
              ))}
              {filters.page < totalPages && <a href={catalogUrl(filters, { page: filters.page + 1 })}>Siguiente →</a>}
            </nav>
          )
        }
      </div>
    </div>
  </form>
</Layout>

<script>
  const form = document.getElementById('catalog-form') as HTMLFormElement;

  // En celular los filtros van plegados; en escritorio siempre visibles en la barra lateral
  if (matchMedia('(min-width: 900px)').matches) form.querySelector('details')!.open = true;

  // Cambiar el orden o la categoría aplica el filtro sin tener que pulsar el botón
  form.addEventListener('change', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.name === 'orden' || target.name === 'categoria') form.requestSubmit();
  });

  // Empty fields are dropped so shared links stay short (/productos?categoria=celular)
  form.addEventListener('formdata', (event) => {
    for (const [key, value] of [...event.formData.entries()]) {
      if (value === '' || (key === 'orden' && value === 'destacados')) event.formData.delete(key);
    }
  });
</script>

<style>
  .catalog {
    padding-top: 24px;
  }

  .search {
    display: flex;
    gap: 8px;
  }

  .search input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0 18px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    font: inherit;
    background: var(--surface);
  }

  .layout {
    display: grid;
    gap: 20px;
    margin-top: 20px;
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 250px minmax(0, 1fr);
      align-items: start;
    }
  }

  .filters {
    padding: 4px 18px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  @media (min-width: 900px) {
    .filters {
      position: sticky;
      top: 80px;
    }

    /* On desktop the filters are always visible */
    .filters summary {
      pointer-events: none;
    }

    .filters summary::after {
      display: none;
    }
  }

  summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '▾';
    margin-left: auto;
    transition: transform 0.15s ease;
  }

  details[open] summary::after {
    transform: rotate(180deg);
  }

  .count {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font-size: 0.75rem;
  }

  fieldset {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 0;
    padding: 14px 0;
    display: grid;
    gap: 8px;
  }

  legend {
    float: left;
    width: 100%;
    margin-bottom: 4px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* Con muchas categorías la lista se desplaza por dentro en vez de estirar la barra */
  .category-options {
    display: grid;
    gap: 8px;
    max-height: 16rem;
    overflow-y: auto;
  }

  .option {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.93rem;
    cursor: pointer;
  }

  .option input {
    width: 18px;
    height: 18px;
    accent-color: var(--navy);
  }

  .price-range {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .filter-actions {
    display: flex;
    gap: 8px;
    padding: 4px 0 16px;
  }

  .results-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .results-count {
    margin: 0;
    font-weight: 600;
  }

  .sort {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .sort select {
    min-height: 40px;
    padding: 0 10px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    font: inherit;
    color: var(--ink);
  }

  .active-filters {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .active-filters a {
    display: inline-flex;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--mint-strong);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .empty {
    padding: 48px 0;
    text-align: center;
    color: var(--muted);
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 28px;
  }

  .pagination a {
    min-width: 40px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    text-align: center;
    text-decoration: none;
    font-weight: 500;
  }

  .pagination a.current {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  .gap {
    padding: 8px 4px;
    color: var(--muted);
  }
</style>
