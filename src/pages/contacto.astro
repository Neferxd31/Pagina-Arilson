---
import Layout from '../layouts/Layout.astro';
import { STORE } from '../config';
---

<Layout title="Contacto" description="Escríbenos por WhatsApp, Instagram o TikTok. Atención personalizada desde Cúcuta.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contacto</p>
      <h1>Hablemos</h1>
      <p class="section-lead">¿Tienes dudas sobre un producto, un pedido al por mayor o una garantía? Escríbenos y te respondemos personalmente.</p>
    </div>
  </section>

  <section class="container section contact">
    <ul class="channels">
      <li>
        <a href={`https://wa.me/${STORE.whatsappNumber}`} target="_blank" rel="noopener" class="channel">
          <span class="channel-label">WhatsApp</span>
          <strong>{STORE.whatsappDisplay}</strong>
        </a>
      </li>
      <li>
        <a href={STORE.instagramUrl} target="_blank" rel="noopener" class="channel">
          <span class="channel-label">Instagram</span>
          <strong>@esencialescolom</strong>
        </a>
      </li>
      <li>
        <a href={STORE.tiktokUrl} target="_blank" rel="noopener" class="channel">
          <span class="channel-label">TikTok</span>
          <strong>@esencialescolomarilson</strong>
        </a>
      </li>
      <li class="channel">
        <span class="channel-label">Ubicación</span>
        <strong>Cúcuta, Norte de Santander</strong>
        <span class="hint">Envíos a toda Colombia</span>
      </li>
      <li class="channel">
        <span class="channel-label">Horario</span>
        <strong>Lorem ipsum dolor sit</strong>
        <span class="hint">Lorem ipsum dolor sit amet</span>
      </li>
    </ul>

    <form id="contact-form" class="contact-form" method="post" novalidate>
      <h2>Escríbenos por WhatsApp</h2>
      <label class="field">
        Tu nombre
        <input name="name" autocomplete="name" required maxlength="80" />
      </label>
      <label class="field">
        Mensaje
        <textarea name="message" required maxlength="500" rows="5" placeholder="Hola, quiero saber si…"></textarea>
      </label>
      <button type="submit" class="btn btn-whatsapp">Enviar por WhatsApp</button>
      <p class="hint">Se abrirá WhatsApp con tu mensaje listo para enviar.</p>
    </form>
  </section>
</Layout>

<script>
  import { STORE } from '../config';
  import { buildContactMessage, whatsappUrl } from '../lib/whatsapp';

  const form = document.getElementById('contact-form') as HTMLFormElement;

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const message = buildContactMessage(String(data.get('name')), String(data.get('message')));
    window.open(whatsappUrl(STORE.whatsappNumber, message), '_blank', 'noopener');
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 860px) {
    .contact {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }

  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .channel {
    display: grid;
    align-content: start;
    gap: 2px;
    height: 100%;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--surface);
    border: 1.5px solid var(--line);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.channel:hover {
    border-color: var(--teal);
  }

  .channel-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-weight: 600;
  }

  .contact-form {
    display: grid;
    gap: 14px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .contact-form h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .contact-form .hint {
    margin: -4px 0 0;
  }
</style>
