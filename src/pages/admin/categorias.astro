---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listCategories } from '../../lib/db';

const categories = await listCategories(env.DB);
const nextPosition = categories.reduce((max, category) => Math.max(max, category.position), 0) + 1;
---

<AdminLayout title="Categorías">
  <h1>Categorías</h1>
  <p class="hint">
    Son las secciones de la tienda. Cada producto pertenece a una; la eliges al crear o editar el producto. El orden define cómo
    aparecen en el filtro y en el inicio.
  </p>

  <form class="card new-category" data-category-form data-method="POST" data-url="/api/admin/categories">
    <h2>Nueva categoría</h2>
    <div class="row">
      <label class="field grow">
        Nombre
        <input name="name" required maxlength="40" placeholder="Ej: Belleza y cuidado personal" />
      </label>
      <label class="field order">
        Orden
        <input name="position" type="number" min="0" max="999" step="1" value={nextPosition} required />
      </label>
      <button type="submit" class="btn">Crear</button>
    </div>
  </form>

  <div id="category-error" class="alert" hidden></div>

  <ul class="list">
    {
      categories.map((category) => (
        <li class="card">
          <form class="row" data-category-form data-method="PUT" data-url={`/api/admin/categories/${category.id}`}>
            <label class="field grow">
              <span class="hint">
                {category.productCount} {category.productCount === 1 ? 'producto' : 'productos'} ·{' '}
                <a href={`/productos?categoria=${category.slug}`} target="_blank">
                  ver en tienda
                </a>
              </span>
              <input name="name" required maxlength="40" value={category.name} aria-label="Nombre de la categoría" />
            </label>
            <label class="field order">
              <span class="hint">Orden</span>
              <input name="position" type="number" min="0" max="999" step="1" value={category.position} required />
            </label>
            <button type="submit" class="btn btn-small">Guardar</button>
            <button type="button" class="btn btn-ghost btn-small" data-delete={`/api/admin/categories/${category.id}`} data-name={category.name}>
              Eliminar
            </button>
          </form>
        </li>
      ))
    }
  </ul>
</AdminLayout>

<script>
  const errorBox = document.getElementById('category-error')!;

  function showErrors(errors: string[]) {
    errorBox.textContent = errors.join(' ');
    errorBox.hidden = false;
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  async function send(method: string, url: string, body?: unknown) {
    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    if (response.ok) {
      location.reload();
      return;
    }
    const result = (await response.json().catch(() => ({}))) as { errors?: string[] };
    showErrors(result.errors ?? ['No se pudo guardar. Intenta de nuevo.']);
  }

  document.querySelectorAll<HTMLFormElement>('[data-category-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      send(form.dataset.method!, form.dataset.url!, { name: data.get('name'), position: Number(data.get('position')) });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!confirm(`¿Eliminar la categoría "${button.dataset.name}"?`)) return;
      send('DELETE', button.dataset.delete!);
    });
  });
</script>

<style>
  h1 {
    font-size: 1.5rem;
    margin: 0 0 4px;
  }

  .card {
    padding: 16px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .new-category {
    margin: 20px 0 16px;
  }

  .new-category h2 {
    font-size: 1.05rem;
    margin: 0 0 10px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 10px;
  }

  .grow {
    flex: 1 1 220px;
  }

  .order {
    width: 90px;
  }

  .alert {
    margin-bottom: 12px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
</style>
