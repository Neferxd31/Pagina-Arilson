---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Admin EsencialesCol</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="admin-header">
      <div class="container admin-nav">
        <a href="/admin" class="admin-brand"><img src="/logo.png" alt="" width="32" height="26" /> Admin</a>
        <nav>
          <a href="/admin" class:list={{ active: path === '/admin' || path.startsWith('/admin/productos') }}>Productos</a>
          <a href="/admin/categorias" class:list={{ active: path.startsWith('/admin/categorias') }}>Categorías</a>
          <a href="/admin/pedidos" class:list={{ active: path.startsWith('/admin/pedidos') }}>Pedidos</a>
          <a href="/" target="_blank">Ver tienda ↗</a>
        </nav>
      </div>
    </header>
    <main class="container admin-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .admin-header {
    background: var(--navy);
    color: #fff;
  }

  .admin-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    flex-wrap: wrap;
  }

  .admin-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    text-decoration: none;
  }

  .admin-brand img {
    filter: brightness(0) invert(1);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 0.9rem;
  }

  nav a {
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
  }

  nav a.active,
  nav a:hover {
    background: var(--navy-soft);
  }

  .admin-main {
    padding-top: 24px;
    padding-bottom: 64px;
  }
</style>
