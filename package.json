    "check:deploy": "node scripts/check-deploy.mjs",
    "db:backup": "node scripts/backup-db.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.8",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@astrojs/netlify": "^8.2.10",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
